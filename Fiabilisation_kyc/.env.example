# ─── MODELE DE CONFIGURATION ──────────────────────────────────────────────────
# Copier ce fichier vers Fiabilisation_kyc/.env et renseigner les valeurs.
# Le .env reel ne doit JAMAIS etre committe (voir .gitignore).

# ─── SECURITE ─────────────────────────────────────────────────────────────────
# Generer une cle avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# ─── MODE APPLICATION ─────────────────────────────────────────────────────────
# PRODUCTION : DEBUG=False imperativement.
# DEBUG=True expose les tracebacks, les settings et sert /media/ sans controle.
DEBUG=False

# ─── HOTES AUTORISES ──────────────────────────────────────────────────────────
# Lister uniquement les domaines reels (ni 0.0.0.0 ni localhost en production).
ALLOWED_HOSTS=kyc.example.of.africa

# ─── HTTPS & COOKIES ──────────────────────────────────────────────────────────
# Valeurs de PRODUCTION ci-dessous. En developpement local uniquement,
# passer les trois premieres a False et SECURE_HSTS_SECONDS a 0.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# ─── BASE DE DONNEES ──────────────────────────────────────────────────────────
# DB_NAME=
# DB_HOST=
# DB_PORT=1433

# ─── CACHE ────────────────────────────────────────────────────────────────────
# Laisser vide pour le cache fichier ; renseigner pour basculer sur Redis.
# CACHE_URL=redis://127.0.0.1:6379/1
# CACHE_KEY_PREFIX=kyc

# ─── DIVERS ───────────────────────────────────────────────────────────────────
# ASSET_VERSION=
