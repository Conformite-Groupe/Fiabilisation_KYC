{
  "rules": [
    {
      "name": "Format téléphone invalide",
      "applicability": "PM",
      "field_name": "TEL",
      "control_type": "composite",
      "parameter": "8 / 15",
      "description": "Le numéro de téléphone comporte moins de 8 caractères ou plus de 15 caractères.",
      "active": true,
      "filiale": "|BOA SN|",
      "conditions": [
        {
          "logic": "AND",
          "field_name": "TEL",
          "operator": "min_length",
          "value": "8"
        },
        {
          "logic": "OR",
          "field_name": "TEL",
          "operator": "max_length",
          "value": "15"
        }
      ]
    },
    {
      "name": "Capital social nul",
      "applicability": "PM",
      "field_name": "CAPITAL",
      "control_type": "composite",
